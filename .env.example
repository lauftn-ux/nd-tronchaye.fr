# --------------------------------------------------------------------
# Required in production. Use a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# --------------------------------------------------------------------
# Postgres connection string. Use Supabase's "Connection Pooling" URL
# (Project Settings → Database → Connection string → "URI" under "Connection pooling",
# Mode: Session). Looks like:
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --------------------------------------------------------------------
# Supabase project (used for Storage uploads of gallery photos).
# Service role key — KEEP SECRET, server-side only. Get it from
# Supabase Dashboard → Project Settings → API → "service_role" key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name (must already exist in Supabase Storage). Default: photos
SUPABASE_STORAGE_BUCKET=photos

# --------------------------------------------------------------------
# SendGrid for the contact form.
SENDGRID_API_KEY=
SENDGRID_VERIFIED_SENDER=

# --------------------------------------------------------------------
# Comma-separated list of origins allowed to make authenticated cross-origin
# requests. Leave empty if client and server are served from the same origin
# (this is the case on Vercel by default).
ALLOWED_ORIGINS=

# --------------------------------------------------------------------
# One-time bootstrap. Set both before the first deploy, then unset and redeploy.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
